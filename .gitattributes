# Ensure consistent line endings across platforms
* text=auto

# Force LF for generated data files
*.csv text eol=lf
# Calendars are stored byte-for-byte: RFC 5545 requires CRLF line endings
*.ics -text

# Python files should use LF
*.py text eol=lf

# Shell scripts should use LF
*.sh text eol=lf

# YAML files should use LF
*.yml text eol=lf
*.yaml text eol=lf
